---
import { Image } from "emdash/ui";

interface Props {
	type: {
		id: string;
		data: {
			title: string;
			catchphrase?: string | null;
			summary?: string | null;
			featured_image?: { id: string; src?: string; alt?: string } | null;
		};
		edit: Record<string, Record<string, string>>;
	};
	/** 1-based position, shown as the card's index label */
	index: number;
	headingLevel?: 2 | 3;
}

const { type, index, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const href = `/types/${type.id}`;
const titleId = `type-${type.id}`;
---

<article class="type-card">
	{
		type.data.featured_image && (
			<a href={href} class="type-card__media" tabindex="-1" aria-hidden="true">
				<Image
					image={type.data.featured_image}
					sizes="(min-width: 960px) 280px, (min-width: 640px) 45vw, 92vw"
				/>
			</a>
		)
	}
	<div class="type-card__body">
		<p class="eyebrow">Type {String(index).padStart(2, "0")}</p>
		<Heading class="type-card__title" id={titleId} {...type.edit.title}>
			<a href={href} class="type-card__link">{type.data.title}</a>
		</Heading>
		{
			type.data.catchphrase && (
				<p class="type-card__catch" {...type.edit.catchphrase}>
					{type.data.catchphrase}
				</p>
			)
		}
	</div>
</article>

<style>
	.type-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--card-padding);
		padding: var(--card-padding);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow:
			0 0 0 1px var(--color-border),
			var(--shadow-card);
		transition: box-shadow var(--transition-base);
	}

	.type-card:hover {
		box-shadow:
			0 0 0 1px var(--color-border-strong),
			var(--shadow-card-hover);
	}

	.type-card:has(.type-card__link:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.type-card__media {
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		background: var(--color-fill);
	}

	.type-card__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
	}

	.type-card__body {
		display: grid;
		gap: var(--spacing-2);
		padding: var(--spacing-1);
	}

	.type-card__title {
		font-size: var(--font-size-xl);
	}

	.type-card__link {
		color: inherit;
		text-decoration: none;
	}

	/* Stretch the link over the whole card */
	.type-card__link::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.type-card__link:focus-visible {
		outline: none;
	}

	.type-card__catch {
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
	}
</style>
