---
import Base from "../../layouts/Base.astro";
import TypeCard from "../../components/TypeCard.astro";
import { getLoveTypes } from "../../utils/love-types";

const { entries: loveTypes, cacheHint } = await getLoveTypes();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title="恋愛タイプ一覧"
	description="恋愛タイプ診断でわかる、すべての恋愛タイプの特徴と相性。"
>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">タイプ一覧</p>
			<h1 class="intro__title">{loveTypes.length}つの恋愛タイプ</h1>
			<p class="intro__lead">
				気持ちの伝え方と、心地いい距離感。ふたつの軸の組み合わせで、恋の傾向を読み解きます。
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			{
				loveTypes.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">タイプがまだありません</h2>
						<p class="empty-state__text">
							管理画面の「恋愛タイプ」からタイプを追加してください。
						</p>
					</div>
				) : (
					<div class="type-grid">
						{loveTypes.map((type, i) => (
							<TypeCard type={type} index={i + 1} headingLevel={2} />
						))}
					</div>
				)
			}
			<div class="types-cta">
				<a href="/shindan" class="btn">自分のタイプを診断する</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.type-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
		gap: var(--spacing-6);
	}

	.types-cta {
		margin-top: var(--spacing-10);
	}
</style>
