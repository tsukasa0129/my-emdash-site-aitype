---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import TypeCard from "../../components/TypeCard.astro";
import { getLoveTypes } from "../../utils/love-types";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: type, cacheHint }, { entries: loveTypes, cacheHint: typesCacheHint }] =
	await Promise.all([getEmDashEntry("love_types", slug), getLoveTypes()]);
if (!type) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(typesCacheHint);
}

// Arriving from the quiz adds ?result=1, which turns the header into a result reveal.
const isResult = Astro.url.searchParams.get("result") === "1";

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(type, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/types/${slug}`,
});

const typeIndex = loveTypes.findIndex((t) => t.id === type.id);
const bestMatchIndex = loveTypes.findIndex((t) => t.id === type.data.best_match);
const bestMatch = bestMatchIndex === -1 ? null : loveTypes[bestMatchIndex];

const traits = [
	{ field: "strengths", label: "恋の強み", text: type.data.strengths },
	{ field: "cautions", label: "気をつけたいこと", text: type.data.cautions },
	{ field: "advice", label: "うまくいくコツ", text: type.data.advice },
] as const;

const shareText = `私の恋愛タイプは「${type.data.title}」でした。`;
const shareUrl = new URL(`/types/${slug}`, Astro.url.origin).toString();
const shareHref = `https://x.com/intent/post?${new URLSearchParams({
	text: shareText,
	url: shareUrl,
})}`;
---

<Base
	title={isResult ? `診断結果：${type.data.title}` : seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? type.data.summary}
	canonical={seo.canonical ?? shareUrl}
	robots={isResult ? "noindex" : seo.robots}
	content={{ collection: "love_types", id: type.data.id, slug }}
>
	<header class="band intro">
		<div class="frame type-header">
			<div class="type-header__text">
				<p class="eyebrow">
					{
						isResult
							? "あなたの恋愛タイプは"
							: `Type ${String(typeIndex + 1).padStart(2, "0")}`
					}
				</p>
				<h1 class="intro__title" {...type.edit.title}>{type.data.title}</h1>
				{
					type.data.catchphrase && (
						<p class="type-header__catch" {...type.edit.catchphrase}>
							{type.data.catchphrase}
						</p>
					)
				}
				{
					type.data.summary && (
						<p class="intro__lead" {...type.edit.summary}>
							{type.data.summary}
						</p>
					)
				}
				{
					isResult && (
						<div class="type-header__actions">
							<a
								href={shareHref}
								class="btn"
								target="_blank"
								rel="noopener noreferrer"
							>
								結果をXでシェア
							</a>
							<a href="/shindan" class="btn btn--ghost">
								もう一度診断する
							</a>
						</div>
					)
				}
			</div>
			{
				type.data.featured_image && (
					<div class="type-header__media" {...type.edit.featured_image}>
						<Image
							image={type.data.featured_image}
							sizes="(min-width: 960px) 420px, 92vw"
							priority
						/>
					</div>
				)
			}
		</div>
	</header>

	<section class="band section">
		<div class="frame type-body">
			<div class="prose" {...type.edit.content}>
				<PortableText value={type.data.content} />
			</div>

			<dl class="traits">
				{
					traits
						.filter((trait) => trait.text)
						.map((trait) => (
							<div class="trait">
								<dt class="eyebrow">{trait.label}</dt>
								<dd {...type.edit[trait.field]}>{trait.text}</dd>
							</div>
						))
				}
			</dl>
		</div>
	</section>

	{
		bestMatch && (
			<section class="band section" aria-labelledby="best-match">
				<div class="frame best-match">
					<div>
						<h2 id="best-match" class="section-head__title">
							相性のいいタイプ
						</h2>
						<p class="best-match__note">
							{type.data.title}のあなたと支え合える組み合わせです。
						</p>
					</div>
					<TypeCard type={bestMatch} index={bestMatchIndex + 1} />
				</div>
			</section>
		)
	}

	{
		!isResult && (
			<section class="band section">
				<div class="frame type-cta">
					<p>あなたはどのタイプ？</p>
					<a href="/shindan" class="btn">診断をはじめる</a>
				</div>
			</section>
		)
	}
</Base>

<style>
	.type-header {
		display: grid;
		gap: var(--spacing-8);
		align-items: center;
	}

	.type-header__catch {
		margin-top: var(--spacing-4);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		color: var(--color-brand);
		max-width: 32ch;
		word-break: auto-phrase;
		text-wrap: balance;
	}

	.type-header__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-8);
	}

	.type-header__media {
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
		aspect-ratio: 4 / 3;
	}

	.type-header__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
	}

	.type-body {
		display: grid;
		gap: var(--spacing-10);
	}

	.traits {
		display: grid;
		gap: var(--spacing-4);
		margin: 0;
		align-content: start;
	}

	.trait {
		display: grid;
		gap: var(--spacing-2);
		padding: var(--card-padding) calc(var(--card-padding) + var(--spacing-2));
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow:
			0 0 0 1px var(--color-border),
			var(--shadow-card);
	}

	.trait dd {
		margin: 0;
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.best-match {
		display: grid;
		gap: var(--spacing-6);
	}

	.best-match__note {
		margin-top: var(--spacing-2);
		color: var(--color-text-secondary);
	}

	.type-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-4);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
	}

	@media (min-width: 960px) {
		.type-header:has(.type-header__media) {
			grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
		}

		.type-body {
			grid-template-columns: minmax(0, var(--content-width)) minmax(0, 1fr);
			column-gap: clamp(2rem, 1rem + 4vw, 5rem);
		}

		.best-match {
			grid-template-columns: minmax(14rem, 1fr) minmax(0, 320px);
			align-items: center;
		}
	}
</style>
