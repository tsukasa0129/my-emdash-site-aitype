---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import TypeCard from "../components/TypeCard.astro";
import { getLoveTypes, getQuestions } from "../utils/love-types";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const POSTS_ON_HOME = 3;

const [
	{ entries: posts, cacheHint },
	{ entries: loveTypes, cacheHint: typesCacheHint },
	{ questions, cacheHint: questionsCacheHint },
	settings,
] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_ON_HOME + 1, // +1 to detect "view all" need
	}),
	getLoveTypes(),
	getQuestions(),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(typesCacheHint);
	Astro.cache.set(questionsCacheHint);
}

const visiblePosts = posts.slice(0, POSTS_ON_HOME);
const hasMorePosts = posts.length > POSTS_ON_HOME;

// Single batched query for tags across the visible posts.
const tagsByEntry = await getTermsForEntries(
	"posts",
	visiblePosts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = visiblePosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	<header class="band intro">
		<div class="frame home-intro">
			<p class="eyebrow">恋愛タイプ診断</p>
			<h1 class="intro__title">{siteTitle}</h1>
			{siteTagline && <p class="intro__subtitle">{siteTagline}</p>}
			{
				questions.length > 0 && (
					<p class="intro__lead">
						{questions.length}
						つの質問に答えるだけで、あなたの恋の傾向と相性のいいタイプがわかります。
					</p>
				)
			}
			<div class="home-intro__actions">
				<a href="/shindan" class="btn">診断をはじめる</a>
				<a href="/types" class="btn btn--ghost">タイプ一覧を見る</a>
			</div>
		</div>
	</header>

	{
		loveTypes.length > 0 && (
			<section class="band section" aria-labelledby="love-types">
				<div class="frame">
					<div class="section-head">
						<h2 id="love-types" class="section-head__title">
							{loveTypes.length}つの恋愛タイプ
						</h2>
						<a href="/types" class="arrow-link">
							すべて見る<span class="sr-only">（タイプ一覧）</span>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="type-grid">
						{loveTypes.map((type, i) => (
							<TypeCard type={type} index={i + 1} />
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		postsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="latest-posts">
				<div class="frame">
					<div class="section-head">
						<h2 id="latest-posts" class="section-head__title">
							新着コラム
						</h2>
						{hasMorePosts && (
							<a href="/posts" class="arrow-link">
								すべて見る<span class="sr-only">（コラム一覧）</span>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M5 12h14" />
									<path d="m12 5 7 7-7 7" />
								</svg>
							</a>
						)}
					</div>
					<div class="post-grid">
						{postsWithTags.map(({ post, tags }) => (
							<PostCard
								post={post}
								tags={tags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.home-intro .eyebrow + .intro__title {
		margin-top: var(--spacing-4);
	}

	.home-intro__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-8);
	}

	.type-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
		gap: var(--spacing-6);
	}
</style>
