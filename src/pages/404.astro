---
import Base from "../layouts/Base.astro";
---

<Base title="ページが見つかりません" robots="noindex" bare>
	<section class="band not-found">
		<div class="frame">
			<p class="eyebrow">404</p>
			<h1 class="not-found__title">ページが見つかりません</h1>
		</div>
	</section>
</Base>

<style>
	.not-found {
		padding-block: clamp(4rem, 2.5rem + 6vw, 8rem);
	}

	.not-found__title {
		margin-top: var(--spacing-3);
		font-size: var(--font-size-2xl);
	}
</style>
