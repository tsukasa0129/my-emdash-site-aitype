{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Landing pages",
		"description": "Pages-only site for article landing pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "My Blog",
		"tagline": "Thoughts on building for the web"
	},
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/pages/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search"
			],
			"fields": [
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	]
}
