{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Landing pages",
		"description": "Pages-only site for article landing pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "My Blog",
		"tagline": "Thoughts on building for the web"
	},
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/pages/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "layout",
					"label": "Layout",
					"type": "select",
					"defaultValue": "default",
					"validation": {
						"options": [
							"default",
							"lp"
						]
					}
				},
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	]
}
